DATABASE_URL="postgresql://cloudpulse:cloudpulse@localhost:5432/cloudpulse"
JWT_SECRET="replace-with-at-least-32-char-secret"
JWT_EXPIRES_IN="1d"
PORT=4000
ENCRYPTION_KEY="generate-with: node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""
REDIS_URL="redis://localhost:6379"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRO_PRICE_ID="price_..."
FRONTEND_URL="http://localhost:3000"

# SMTP (optional, uses Ethereal fake SMTP in dev)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="CloudPulse <alerts@cloudpulse.dev>"

# Cloud Provider Credentials
# AWS, GCP, and Azure credentials are stored per-account in the database
# (encrypted with AES-256-GCM using ENCRYPTION_KEY above).
# No global cloud provider environment variables are needed.
# Credentials are provided through the "Connect Cloud Account" UI:
#   - AWS: Access Key + Secret Key, or IAM Role ARN
#   - GCP: Service Account JSON key
#   - Azure: Tenant ID + Client ID + Client Secret + Subscription ID
